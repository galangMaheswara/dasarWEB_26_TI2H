# Konfigurasi Koneksi Database PostgreSQL — SIMPUS-Mini
# Salin file ini menjadi .env atau atur sebagai environment variable di server produksi.
# Jangan pernah meng-commit file .env berisi kredensial asli ke repository publik.

DB_HOST=localhost
